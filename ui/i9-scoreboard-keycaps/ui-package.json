{
  "schemaVersion": "1.0",
  "id": "i9-scoreboard-keycaps",
  "revision": 4,
  "status": "draft",
  "creativeBrief": {
    "objective": "Provide reusable PNG keycaps for data-driven panel compositing and world prompts while the physical shell is swappable through a semantic screen-surface adapter.",
    "audience": "First-stage Just Make Bread players on B+ scaled views.",
    "approval": "Technical package correction in progress; final visual adoption remains HUMAN VISUAL PENDING."
  },
  "classification": {
    "packageScope": "component-family",
    "renderStrategy": "hybrid",
    "usageContexts": [
      "world-scoreboard",
      "tutorial",
      "lifecycle-results",
      "world-prompts"
    ]
  },
  "visualIdentity": {
    "palette": [
      "frame #34454C",
      "panel #263746",
      "glyph #F2F1EA",
      "key outer border #000000",
      "available fill #B9F3F5"
    ],
    "geometryRules": [
      "true physical 3D nine-slice with fixed corners and axis-only edges",
      "default central 4.15x1.55x0.26",
      "standard keycap 1:1 and wide keycap 2:1 with equal apparent outline thickness"
    ],
    "hierarchyRules": [
      "exactly nine shell segments plus one independent semantic screen",
      "all board content is rendered into the semantic screen material map",
      "each board instance owns an independent screen material and texture"
    ],
    "continuityAnchors": [
      "Galmuri labels",
      "muted steel frame",
      "slate panel face",
      "warm off-white glyphs"
    ],
    "forbiddenChanges": [
      "floating board text",
      "standalone tutorial keycap scene children",
      "role-specific frame or panel construction",
      "runtime CSS/SVG/canvas keycap construction",
      "runtime use of the full tutorial-panel-v002 reference image",
      "brittle GLB node-name coupling"
    ]
  },
  "style": {
    "profile": "default-style",
    "embeddedSummary": {
      "family": "Primary physical scoreboard",
      "tone": "casual readable factory signage",
      "contentOwnership": "semantic panelSurface material map"
    },
    "referenceAssets": [
      "canonical/i9-scoreboard-keycaps-system-v003-black-outline.png",
      "qa/keycap-border-comparison-v002-v003.png"
    ]
  },
  "targets": [
    {
      "id": "standard-keycap",
      "kind": "component",
      "role": "input-keycap",
      "description": "Blank, legacy W/A/S/D/E, and current Q/arrow transparent PNG keys.",
      "requiredForProduction": true
    },
    {
      "id": "wide-keycap",
      "kind": "component",
      "role": "wide-input-keycap",
      "description": "Blank, SPACE, and unbound SHIFT transparent PNG keys.",
      "requiredForProduction": true
    },
    {
      "id": "dynamic-panel-compositor",
      "kind": "component",
      "role": "semantic-screen-renderer",
      "description": "Shared CanvasTexture foundation for central, tutorial and result panels; keycaps are PNG drawImage inputs.",
      "requiredForProduction": true
    },
    {
      "id": "scoreboard-surface-adapter",
      "kind": "component",
      "role": "asset-surface-boundary",
      "description": "True width+height 3D nine-slice fallback/future asset shell with independent semantic screen materials.",
      "requiredForProduction": true
    },
    {
      "id": "tutorial-panel",
      "kind": "component",
      "role": "qa-only-reference",
      "description": "Superseded full-panel v002 raster; forbidden as a runtime map.",
      "requiredForProduction": false
    },
    {
      "id": "world-material-prompt",
      "kind": "component",
      "role": "world-prompt-e-q",
      "description": "Canonical material pickup E and floor-drop Q atlas planes.",
      "requiredForProduction": true
    },
    {
      "id": "world-production-prompt",
      "kind": "component",
      "role": "world-prompt-space",
      "description": "Production-block SPACE atlas plane.",
      "requiredForProduction": true
    },
    {
      "id": "world-reset-prompt",
      "kind": "component",
      "role": "world-prompt-reset-e",
      "description": "Failed-awaiting-reset E atlas plane.",
      "requiredForProduction": true
    }
  ],
  "states": [
    {
      "id": "default",
      "description": "Normal key state.",
      "requiredForProduction": true
    },
    {
      "id": "lit",
      "description": "Available or highlighted key state.",
      "requiredForProduction": true
    },
    {
      "id": "disabled",
      "description": "Unavailable key state.",
      "requiredForProduction": true
    },
    {
      "id": "tutorial-dynamic",
      "description": "Tutorial composed from atlas image regions plus dynamic Galmuri labels.",
      "requiredForProduction": true
    },
    {
      "id": "central-dynamic",
      "description": "Authoritative timer, score and result content.",
      "requiredForProduction": true
    },
    {
      "id": "breakdown-dynamic",
      "description": "Authoritative ordered score breakdown rows.",
      "requiredForProduction": true
    },
    {
      "id": "tutorial-static",
      "description": "Rejected full-panel static tutorial reference; runtime forbidden.",
      "requiredForProduction": false
    }
  ],
