{
  "name": "track1-production-puzzle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && vitest run",
    "check:privacy": "node scripts/check-privacy.mjs --mode=working",
    "check:privacy:staged": "node scripts/check-privacy.mjs --mode=staged",
    "check:privacy:prepush": "node scripts/check-privacy.mjs --mode=prepush",
    "check:privacy:first-push": "node scripts/check-privacy.mjs --mode=first-push",
    "check:deploy": "npm run build && npm run check:privacy && node scripts/check-deployment-readiness.mjs",
    "hooks:setup": "node scripts/setup-git-hooks.mjs",
    "preview": "vite preview",
    "export:chatgpt-sources": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/export-chatgpt-sources.ps1"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "0.180.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
