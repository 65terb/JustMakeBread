#!/bin/sh
set -eu

remote_name=${1-}
if [ -z "$remote_name" ]; then
  echo "pre-push requires the Git remote name as its first argument." >&2
  exit 1
fi

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

npm_command=npm
if command -v npm.cmd >/dev/null 2>&1; then
  npm_command=npm.cmd
fi

"$npm_command" run check:privacy:prepush -- "--remote=$remote_name"
